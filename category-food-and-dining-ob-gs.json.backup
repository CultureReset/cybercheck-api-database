    "place_id": "ChIJjUQA6PQFmogRAOYE735Gxj4",
    "name": "8 Reale OBAL",
    "type": "restaurant",
    "city": "Orange Beach",
    "state": "AL",
    "address": "4851 Wharf Pkwy W Suite D-112, Orange Beach, AL 36561, USA",
