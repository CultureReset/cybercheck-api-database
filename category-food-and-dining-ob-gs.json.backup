    "name": "Mikee's Seafood",
    "category": "specialty",
    "city": "Gulf Shores",
    "state": "AL",
    "address": "205 E 2nd Ave, Gulf Shores, AL 36542, USA",
    "phone": "+1 251-948-6452",
