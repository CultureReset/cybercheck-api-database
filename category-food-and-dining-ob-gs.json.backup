    "place_id": "ChIJ-czdfbcEmogRrXSPDhnJt7M",
    "name": "Shrimpy's Grill and Golf",
    "type": "activity_accommodation",
    "city": "Orange Beach",
    "state": "AL",
    "address": "204 E 2nd Ave, Gulf Shores, AL 36542, USA",
    "phone": "+1 251-948-6464",
    "website": "https://www.shrimpysminigolf.com/",
    "google_maps_url": "https://maps.google.com/?q=30.2507228,-87.6877932",
