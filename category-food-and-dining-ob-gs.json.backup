  {
    "place_id": "ChIJMTiveY9zi4gRkyVmdn_EPZs",
    "name": "Lake Wedowee Winery and Brewery",
    "category": "specialty",
    "city": "Orange Beach",
    "state": "AL",
    "address": "29 Main St S, Wedowee, AL 36278, USA",
