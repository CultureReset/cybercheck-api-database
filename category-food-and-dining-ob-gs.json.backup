  {
    "place_id": "ChIJ42RdmicFmogRUCucAsxnWRU",
    "name": "Acme Oyster House",
    "category": "specialty",
    "city": "Gulf Shores",
    "state": "AL",
    "address": "216 E 24th Ave, Gulf Shores, AL 36542, USA",
    "phone": "+1 251-424-1783",
