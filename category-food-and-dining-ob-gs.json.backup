    "place_id": "ChIJaWhxAtEEmogRrMWZHgkiAY0",
    "name": "The Cove Bar and Grill",
    "type": "activity_accommodation",
    "city": "Gulf Shores",
    "state": "AL",
    "address": "131 Cove Ave, Gulf Shores, AL 36542, USA",
    "phone": "+1 251-968-5353",
