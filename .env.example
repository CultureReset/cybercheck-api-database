# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-key

# Auth
JWT_SECRET=change-this-to-a-random-string

# Server
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Stripe — required for all payment processing
STRIPE_SECRET_KEY=sk_test_...           # Your Stripe secret key (Stripe Dashboard → API keys)
STRIPE_PUBLISHABLE_KEY=pk_test_...      # Your Stripe publishable key (same page)
STRIPE_WEBHOOK_SECRET=whsec_...         # From Stripe Dashboard → Webhooks (optional for now)

# Stripe Connect — required for businesses to connect THEIR Stripe accounts
# 1. Go to Stripe Dashboard → Settings → Connect → Settings
# 2. Add redirect URI: https://cybercheck-api-database.vercel.app/api/stripe/connect-callback
# 3. Copy the Client ID below
STRIPE_CLIENT_ID=ca_...                 # Your platform's Connect client ID (starts with ca_)
STRIPE_CONNECT_REDIRECT_URI=https://cybercheck-api-database.vercel.app/api/stripe/connect-callback
DASHBOARD_URL=https://cybercheck-login.vercel.app
PLATFORM_FEE_PERCENT=1                  # Your cut of each transaction (default 1%)

# Twilio (SMS) — required for booking confirmations + owner alerts
# Get these from https://console.twilio.com
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_PHONE_NUMBER=+18005551234  (your Twilio phone number)

# SendGrid (email) — add when ready
# SENDGRID_API_KEY=

# AI — add when ready
# GROQ_API_KEY=
# CLAUDE_API_KEY=
