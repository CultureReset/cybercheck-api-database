{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": { "maxDuration": 30 }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ],
  "crons": [
    {
      "path": "/api/sms/send-reminders",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/public/waivers/send-reminders",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/sms/send-daily-menu-prompts",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/qr/digest/daily",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/qr/digest/weekly",
      "schedule": "0 8 * * 1"
    },
    {
      "path": "/api/reviews/send-daily",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/rides/expire",
      "schedule": "* * * * *"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
