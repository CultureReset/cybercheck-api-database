\f5\fs23\fsmilli11700 \cf6 \cb7 // Every question gets captured\
async function captureQuestion(question, source) \{\
  await supabase.from('question_training_data').insert(\{\
    question_text: question,\
    question_source: source,\
    predicted_intent: null,  // Will fill after AI processes\
    user_confirmed: null,    // Will update after user action\
    quality_score: null      // Will calculate later\
  \});\
\}\
