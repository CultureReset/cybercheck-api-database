\f5\fs23\fsmilli11700 \cf6 \cb7 // Clean and prepare data for training\
async function prepareTrainingData() \{\
  // Get all new questions\
  const questions = await getUnprocessedQuestions();\
  \
  // Filter high-quality examples\
  const goodExamples = questions.filter(q => \
    q.user_confirmed === true &&      // User confirmed it was correct\
    q.question_text.length > 10 &&    // Not too short\
    q.question_text.length < 500 &&   // Not too long\
    q.confidence_score > 0.7          // AI was fairly confident\
  );\
  \
  // Label the data\
  const labeled = await labelData(goodExamples);\
  \
  return labeled;\
\}\
