\f5\fs23\fsmilli11700 \cf6 \cb7 -- User's trusted actions (pre-approved)\
CREATE TABLE user_trusted_actions (\
  id uuid PRIMARY KEY,\
  user_id uuid,\
  action_name text,                    -- "weekly_sales_report"\
  action_type text,                    -- "automation", "bundle", "single"\
  tasks jsonb,                         -- Array of sub-tasks\
  auto_approved boolean DEFAULT true,  -- No SMS approval needed\
  delivery_method text,                -- "email", "sms", "both"\
  delivery_schedule text,              -- "every Friday at 8am"\
  cron_expression text,                -- "0 8 * * 5" (Friday 8am)\
  last_run timestamp,\
  next_run timestamp,\
  is_active boolean DEFAULT true,\
  created_at timestamp DEFAULT now()\
);\
\
-- Task bundles (multi-part requests)\
CREATE TABLE task_bundles (\
  id uuid PRIMARY KEY,\
  user_id uuid,\
  bundle_name text,                    -- Auto-generated or user-named\
  original_question text,              -- What user asked\
  sub_tasks jsonb,                     -- [\{task: "pull_sales", status: "completed"\}, ...]\
  total_tasks int,\
  completed_tasks int,\
  status text,                         -- "pending_approval", "executing", "completed", "failed"\
  requires_approval boolean,\
  approved_at timestamp,\
  started_at timestamp,\
  completed_at timestamp,\
  result_url text,                     -- Link to generated report/chart\
  delivery_method text,\
  delivered_at timestamp,\
  created_at timestamp DEFAULT now()\
);\
\
-- Scheduled automations\
CREATE TABLE scheduled_automations (\
  id uuid PRIMARY KEY,\
  user_id uuid,\
  automation_name text,\
  task_bundle_id uuid,                 -- Reference to task bundle template\
  schedule_cron text,                  -- "0 8 * * 5"\
  schedule_description text,           -- "Every Friday at 8am"\
  delivery_method text,                -- "email", "sms"\
  delivery_address text,               -- email or phone\
  is_active boolean DEFAULT true,\
  last_executed timestamp,\
  next_execution timestamp,\
  execution_count int DEFAULT 0,\
  created_at timestamp DEFAULT now()\
);\
\
-- Automation execution history\
CREATE TABLE automation_executions (\
  id uuid PRIMARY KEY,\
  automation_id uuid,\
  user_id uuid,\
  executed_at timestamp DEFAULT now(),\
  status text,                         -- "success", "failed", "partial"\
  tasks_completed int,\
  tasks_failed int,\
  result_url text,\
  error_message text,\
  execution_time_seconds int\
);\
