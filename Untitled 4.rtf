\f5\fs23\fsmilli11700 \cf6 \cb7 -- Example: AI Service can only READ, never UPDATE api_keys\
CREATE POLICY "ai_service_read_only"\
  ON cybercheck_api_keys\
  FOR SELECT\
  TO ai_service_role\
  USING (true);\
\
-- API Gateway can read/write api_keys\
CREATE POLICY "api_gateway_full_access"\
  ON cybercheck_api_keys\
  FOR ALL\
  TO api_gateway_role\
  USING (true);\
