\f5\fs23\fsmilli11700 \cf6 \cb7 -- Capture EVERY question\
CREATE TABLE question_training_data (\
  id uuid PRIMARY KEY,\
  user_id uuid,\
  session_id uuid,\
  \
  -- The question\
  question_text text,\
  question_source text,              -- voice, text, web, app\
  timestamp timestamp DEFAULT now(),\
  \
  -- AI's understanding\
  predicted_intent text,\
  predicted_entities jsonb,\
  predicted_action_type text,        -- READ or WRITE\
  confidence_score decimal,\
  \
  -- Was it correct?\
  user_confirmed boolean,            -- Did user say "yes" or execute?\
  user_corrected boolean,            -- Did user correct it?\
  correct_intent text,               -- If user corrected\
  correct_entities jsonb,\
  \
  -- Metadata\
  platform text,                     -- gcr, cybercheck, ghost_os\
  language text DEFAULT 'en',\
  complexity text,                   -- simple, medium, complex\
  \
  -- Training status\
  used_for_training boolean DEFAULT false,\
  training_batch_id uuid,\
  quality_score decimal              -- 0-1, how good this example is\
);\
\
-- User feedback on AI responses\
CREATE TABLE ai_feedback (\
  id uuid PRIMARY KEY,\
  question_id uuid REFERENCES question_training_data(id),\
  user_id uuid,\
  \
  -- Feedback\
  feedback_type text,                -- thumbs_up, thumbs_down, correction\
  feedback_text text,\
  was_helpful boolean,\
  \
  -- What should have happened\
  expected_result text,\
  actual_result text,\
  \
  timestamp timestamp DEFAULT now()\
);\
\
-- Model versions and performance\
CREATE TABLE model_versions (\
  id uuid PRIMARY KEY,\
  version_name text,                 -- "intent-ai-v1.0.0"\
  model_type text,                   -- "fine-tuned-gpt-3.5", "custom-bert"\
  \
  -- Training info\
  trained_on_examples int,\
  training_completed_at timestamp,\
  \
  -- Performance metrics\
  accuracy decimal,                  -- % correct\
  precision decimal,\
  recall decimal,\
  f1_score decimal,\
  avg_inference_time_ms int,\
  \
  -- Comparison to baseline (OpenAI)\
  better_than_openai boolean,\
  cost_per_1k_requests decimal,\
  \
  -- Deployment\
  is_active boolean DEFAULT false,\
  deployed_at timestamp,\
  \
  created_at timestamp DEFAULT now()\
);\
\
-- A/B testing results\
CREATE TABLE model_ab_tests (\
  id uuid PRIMARY KEY,\
  test_name text,\
  model_a_version uuid,              -- Custom model\
  model_b_version text,              -- "openai-gpt-4"\
  \
  -- Results\
  model_a_accuracy decimal,\
  model_b_accuracy decimal,\
  model_a_speed_ms int,\
  model_b_speed_ms int,\
  model_a_cost decimal,\
  model_b_cost decimal,\
  \
  winner text,                       -- "model_a" or "model_b"\
  sample_size int,\
  \
  started_at timestamp,\
  completed_at timestamp\
);\
