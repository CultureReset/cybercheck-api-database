async function generateWeeklySalesReport(userId, data) \{\
  // Use a charting library (Chart.js, D3.js)\
  const charts = \{\
    sales_chart: createLineChart(data.sales),\
    leads_funnel: createFunnelChart(data.leads),\
    conversion_pie: createPieChart(data.conversions)\
  \};\
  \
  // Generate PDF with charts embedded\
  const pdf = await createPDF(\{\
    title: "Weekly Sales Report",\
    date_range: "Jan 8 - Jan 15, 2026",\
    sections: [\
      \{\
        title: "Sales Overview",\
        chart: charts.sales_chart,\
        metrics: \{\
          total_sales: "$12,450",\
          avg_order: "$248",\
          growth: "+15%"\
        \}\
      \},\
      \{\
        title: "Lead Performance",\
        chart: charts.leads_funnel,\
        metrics: \{\
          total_leads: 42,\
          from_landing_page: 28,\
          closed: 12,\
          close_rate: "28.6%"\
        \}\
      \},\
      \{\
        title: "Website Traffic",\
        chart: charts.conversion_pie,\
        metrics: \{\
          visits: 1247,\
          unique: 892,\
          bounce_rate: "42%"\
        \}\
      \}\
    ]\
  \});\
  \
  return pdf;\
\}\
